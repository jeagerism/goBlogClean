# Copy to .env for local development (never commit .env)

# PostgreSQL connection string (lib/pq format)
# Example: postgres://user:password@localhost:5432/mydatabase?sslmode=disable&TimeZone=Asia/Bangkok
DATABASE_URL=postgresql://neondb_owner:npg_N1CgekLjaZJ9@ep-bold-wildflower-a1c4niy1.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Strong secret for signing JWTs (use a long random string in production)
JWT_SECRET=random-secret-key-for-jwt-signing-and-verification

# HTTP port (Cloud Run sets this automatically)
PORT=8080

# Comma-separated origins for CORS, or * for development
CORS_ALLOW_ORIGINS=*

# Optional database pool tuning
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=15m
